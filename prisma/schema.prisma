// ─── CareBridge Prisma Schema ───
// Maps to CareBridge domain types from src/types/index.ts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──

enum InsuranceType {
  medicare
  medicaid
  private
  va
  self_pay
}

enum InsuranceStatus {
  active
  pending
  expired
  verified
}

enum CareLevel {
  independent_living
  assisted_living
  skilled_nursing
  long_term_care
  rehabilitation
  home_health
  hospice
  memory_care
}

enum PatientStatus {
  admitted
  assessment_in_progress
  ready_for_discharge
  placed
  discharged
}

enum PlacementStatus {
  assessment
  searching
  matching
  pending_approval
  approved
  in_progress
  completed
  cancelled
}

enum UserRole {
  social_worker
  discharge_planner
  administrator
  facility_coordinator
  superadmin
  customer
}

enum FacilityType {
  skilled_nursing_facility
  rehabilitation_center
  assisted_living
  long_term_care
  home_health_agency
  hospice
}

enum MediaType {
  image
  gaussian_splat
  video
}

enum ActivityType {
  placement
  assessment
  admission
  discharge
  note
  milestone
}

enum Priority {
  low
  medium
  high
  emergency
}

enum OrganizationType {
  hospital
  facility
}

enum JoinRequestStatus {
  pending
  approved
  denied
}

// ── Models ──

model Organization {
  id        String           @id
  name      String
  slug      String           @unique
  type      OrganizationType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  users         User[]
  patients      Patient[]
  facilities    Facility[]
  hospitals     Hospital[]
  placements    Placement[]
  activities    ActivityEvent[]
  inviteCodes   InviteCode[]
  joinRequests  JoinRequest[]
  chats                Chat[]
  documents            Document[]
  documentUploadTokens DocumentUploadToken[]
}

model InviteCode {
  id             String        @id @default(cuid())
  code           String        @unique
  organizationId String
  role           UserRole?
  createdById    String
  expiresAt      DateTime?
  maxUses        Int?
  usedCount      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  createdBy      User          @relation("InviteCodeCreator", fields: [createdById], references: [id])
  joinRequests   JoinRequest[]
}

model JoinRequest {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  inviteCodeId   String?
  status         JoinRequestStatus @default(pending)
  requestedRole  UserRole?
  reviewedById   String?
  reviewedAt     DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation("JoinRequestUser", fields: [userId], references: [id])
  inviteCode     InviteCode?      @relation(fields: [inviteCodeId], references: [id])
  reviewedBy     User?            @relation("JoinRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([userId, status])
}

model User {
  id                     String           @id
  email                  String           @unique
  firstName              String
  lastName               String
  role                   UserRole
  title                  String
  department             String
  hospitalId             String
  avatarUrl              String?
  phone                  String
  organizationId         String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  organization           Organization?    @relation(fields: [organizationId], references: [id])
  patients               Patient[]
  placements             Placement[]
  activities             ActivityEvent[]
  uploadedDocuments      PatientDocument[] @relation("DocumentUploader")
  createdInviteCodes     InviteCode[]     @relation("InviteCodeCreator")
  reviewedJoinRequests   JoinRequest[]    @relation("JoinRequestReviewedBy")
  joinRequests           JoinRequest[]    @relation("JoinRequestUser")
  chats                  Chat[]
  documents              Document[]           @relation("DocumentUploader")
  documentAccessLogs     DocumentAccessLog[]
  documentVersions       DocumentVersion[]    @relation("VersionUploader")
}

model Patient {
  id                    String        @id
  mrn                   String        @unique
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  age                   Int
  gender                String
  address               Json
  phone                 String
  emergencyContact      Json
  insurance             Json
  primaryDiagnosis      String
  secondaryDiagnoses    String[]
  careLevelRequired     CareLevel
  notes                 String
  socialWorkerId        String
  hospitalId            String
  organizationId        String
  admissionDate         DateTime
  estimatedDischargeDate DateTime?
  status                PatientStatus  @default(admitted)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization          Organization   @relation(fields: [organizationId], references: [id])
  socialWorker          User           @relation(fields: [socialWorkerId], references: [id])
  placements            Placement[]
  activityEvents        ActivityEvent[]
  documents             PatientDocument[]
}

model Facility {
  id                 String       @id
  name               String
  description        String?
  type               FacilityType
  address            Json
  phone              String
  email              String
  website            String?
  contacts           Json
  licensure          String[]
  accreditations     String[]
  // Constrained to >= 0 by CHECK "Facility_capacity_non_negative" (migration 20260803020000)
  capacity           Int
  // Derived from confirmed placements; constrained to >= 0 and <= capacity by CHECK constraints (migration 20260803020000)
  currentOccupancy   Int
  insuranceAccepted  String[]
  careLevelsOffered  CareLevel[]
  specialties        String[]
  rating             Float
  reviewsCount       Int
  hasAvailability    Boolean      @default(true)
  waitlistDays       Int?
  acceptsMedicare    Boolean      @default(true)
  acceptsMedicaid    Boolean      @default(false)
  organizationId     String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id])
  placements         Placement[]
  media              FacilityMedia[]
}

model FacilityMedia {
  id             String     @id @default(cuid())
  facilityId     String
  type           MediaType
  key            String
  url            String
  thumbnailUrl   String?
  fileSize       Int?
  mimeType       String?
  width          Int?
  height         Int?
  displayOrder   Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  facility       Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
}

model PatientDocument {
  id             String     @id @default(cuid())
  patientId      String
  name           String
  key            String
  url            String
  fileSize       Int?
  mimeType       String?
  category       String     @default("other")
  uploadedById   String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy     User       @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([patientId])
}

model Placement {
  id                   String          @id
  patientId            String
  facilityId           String?
  socialWorkerId       String
  status               PlacementStatus @default(assessment)
  careLevel            CareLevel
  priority             Priority        @default(medium)
  assessmentNotes      String?
  preferredLocation    Json?
  matchedFacilities    String[]
  selectedFacilityId   String?
  insurancePreAuthorized Boolean      @default(false)
  estimatedCost        Float?
  approvedBy           String?
  approvalDate         DateTime?
  startDate            DateTime?
  completedDate        DateTime?
  cancellationReason   String?
  notes                String
  organizationId       String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organization         Organization    @relation(fields: [organizationId], references: [id])
  patient              Patient         @relation(fields: [patientId], references: [id])
  facility             Facility?       @relation(fields: [facilityId], references: [id])
  socialWorker         User            @relation(fields: [socialWorkerId], references: [id])
}

// ── HIPAA Documentation Vault Models ──

enum DocumentCategory {
  patient_records
  medical_documentation
  consent_forms
  insurance_documents
  compliance_documents
  policies
  procedures
  audit_documents
  employee_training_records
  business_associate_agreements
  security_documentation
  privacy_documentation
  other
}

enum DocumentAccessAction {
  VIEW
  DOWNLOAD
  UPLOAD
  UPDATE
  DELETE
  SHARE
  EXPORT
  ARCHIVE
  RESTORE
}

model Document {
  id               String             @id @default(cuid())
  organizationId   String
  uploadedById     String
  title            String
  description      String?
  category         DocumentCategory   @default(other)
  tags             String[]
  fileName         String
  fileType         String
  fileSize         Int
  storageKey       String
  storageBucket    String
  storageEndpoint  String
  encryptionKey    String?            // Envelope encryption key (encrypted with master key)
  encryptionIv     String?            // Initialization vector
  checksum         String?            // SHA-256 hash for integrity verification
  mimeType         String
  version          Int                @default(1)
  isArchived       Boolean            @default(false)
  isOnLegalHold    Boolean            @default(false)
  retentionDate    DateTime?
  notes            String?
  expiresAt        DateTime?
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id])
  uploadedBy       User               @relation("DocumentUploader", fields: [uploadedById], references: [id])
  accessLogs       DocumentAccessLog[]
  versions         DocumentVersion[]

  @@index([organizationId])
  @@index([uploadedById])
  @@index([category])
  @@index([isArchived])
  @@index([deletedAt])
  @@index([title])
}

model DocumentUploadToken {
  id             String    @id
  organizationId String
  key            String
  fileName       String
  fileSize       Int
  mimeType       String
  checksum       String
  encryptionKey  String
  encryptionIv   String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([key])
  @@index([expiresAt])
  @@index([usedAt])
}

model DocumentAccessLog {
  id             String               @id @default(cuid())
  documentId     String
  userId         String
  action         DocumentAccessAction
  timestamp      DateTime             @default(now())
  ipAddress      String?
  userAgent      String?
  success        Boolean              @default(true)
  details        String?              // Additional context (e.g., "Download expired", "Permission denied")

  document       Document             @relation(fields: [documentId], references: [id])
  user           User                 @relation(fields: [userId], references: [id])

  @@index([documentId])
  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([success])
}

model DocumentVersion {
  id             String      @id @default(cuid())
  documentId     String
  version        Int
  fileName       String
  fileType       String
  fileSize       Int
  storageKey     String
  storageBucket  String
  checksum       String?
  uploadedById   String
  changeNotes    String?
  createdAt      DateTime    @default(now())

  document       Document    @relation(fields: [documentId], references: [id])
  uploadedBy     User        @relation("VersionUploader", fields: [uploadedById], references: [id])

  @@index([documentId])
  @@index([version])
}

model ActivityEvent {
  id             String       @id
  type           ActivityType
  title          String
  description    String
  patientName    String
  patientId      String
  timestamp      DateTime     @default(now())
  userId         String
  organizationId String

  organization   Organization @relation(fields: [organizationId], references: [id])
  patient        Patient      @relation(fields: [patientId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model Hospital {
  id             String       @id
  name           String
  address        Json
  phone          String
  npi            String
  imageUrl       String?
  logoUrl        String?
  organizationId String

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Chat {
  id             String       @id @default(cuid())
  title          String       @default("New Chat")
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  messages       ChatMessage[]

  @@index([userId])
  @@index([organizationId])
  @@index([updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String   // "user" | "assistant" | "system"
  content   String
  createdAt DateTime @default(now())

  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}
